# Leave blank to bundle local optimized frame assets.
# For a real CDN, set the HTTPS directory containing desktop/ and mobile/.
VITE_FRAMES_BASE_URL=
# optimized uses 1280x720 desktop and 768x432 mobile copies.
# original uses the preserved 1920x1080 source folders.
VITE_FRAME_VARIANT=optimized
# Enable only for a measured QA build. Disabled for normal production.
VITE_ENABLE_DIAGNOSTICS=false
